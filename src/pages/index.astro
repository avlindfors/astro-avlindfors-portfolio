---
import Layout from '../layouts/Layout.astro'
import resumeData from '../data/resume'
import ResumeHero from '../components/resume/ResumeHero'
import ResumeSkills from '../components/resume/ResumeSkills'
import ResumeLanguages from '../components/resume/ResumeLanguages'
import ResumeEducation from '../components/resume/ResumeEducation'
import ResumeExperience from '../components/resume/ResumeExperience'
import ResumeContact from '../components/resume/ResumeContact'
import AboutCTA from '../components/AboutCTA.astro'
import PdfLink from '../components/PdfLink.astro'

const { sections } = resumeData
---

<Layout
  title="Resume – Alexander Lindfors"
  description="Full stack developer with 9 years of experience in React, TypeScript and Node.js. View the resume of Alexander Lindfors."
>
  <div class="rise-in flex flex-col gap-4 md:gap-10">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-4 sm:gap-2">
        <ResumeHero
          client:load
          name={resumeData.name}
          subtitles={resumeData.subtitles}
          tagline={resumeData.tagline}
          contact={resumeData.contact}
        />

        <PdfLink />
      </div>
      <div class="border-t border-(--line)"></div>
    </div>
    <!--
      Mobile order:  Experience → Education → Languages → Skills
      Desktop order: [Education, Languages, Skills] | [Experience]
    -->
    <div
      class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_1fr] lg:gap-x-0 lg:gap-y-8"
    >
      <!-- Experience — order-1 mobile, right col spanning all rows desktop -->
      <div
        class="order-1 lg:col-start-2 lg:row-start-1 lg:row-span-5 lg:pl-6 flex flex-col gap-6"
      >
        <ResumeExperience
          title={sections.experience.title}
          icon={sections.experience.icon}
          experience={resumeData.experience}
        />
        <ResumeExperience
          title={sections.olderExperience.title}
          icon={sections.olderExperience.icon}
          experience={resumeData.olderExperience}
          compact={true}
        />
      </div>

      <!-- Education — order-2 mobile, left col row 1 desktop -->
      <div class="order-2 lg:col-start-1 lg:row-start-1">
        <ResumeEducation
          title={sections.education.title}
          icon={sections.education.icon}
          education={resumeData.education}
        />
      </div>

      <!-- Skills — order-3 mobile, left col row 2 desktop -->
      <div class="order-3 lg:col-start-1 lg:row-start-2">
        <ResumeSkills
          title={sections.skills.title}
          icon={sections.skills.icon}
          skills={resumeData.skills}
        />
      </div>

      <!-- Languages — order-4 mobile, left col row 3 desktop -->
      <div class="order-4 lg:col-start-1 lg:row-start-3">
        <ResumeLanguages
          title={sections.languages.title}
          icon={sections.languages.icon}
          languages={resumeData.languages}
        />
      </div>

      <!-- Contact — order-5 mobile, left col row 4 desktop -->
      <div class="order-5 lg:col-start-1 lg:row-start-4">
        <ResumeContact
          title={sections.contact.title}
          icon={sections.contact.icon}
          contact={resumeData.contact}
        />
      </div>
    </div>
  </div>
  <div class="border-t border-(--line)"></div>
  <AboutCTA />
</Layout>
