---
import Layout from '../layouts/Layout.astro'
import FeatureSection from '../components/FeatureSection.astro'
import HelloThere from '../components/HelloThere'
import resumeData from '../data/resume'
---

<Layout
  title="About – Alexander Lindfors"
  description="Learn more about Alexander Lindfors — a full stack developer specializing in React, TypeScript and Node.js, with 9 years of experience building web applications."
>
  <div class="flex flex-col gap-16">
    <!-- Hero -->
    <section>
      <HelloThere client:load />
      <div class="mb-2">
        <h1
          class="display-title max-w-3xl text-4xl leading-[1.02] font-bold tracking-tight text-(--sea-ink) sm:text-6xl"
        >
          Alexander Lindfors
        </h1>
        <!-- <p class="text-xs">アレックス</p> -->
      </div>
      <p class="mb-2 text-sm">Software Engineer &bull; Full Stack Developer</p>
      <p class="mb-8 text-base text-(--sea-ink-soft) sm:text-lg">
        {resumeData.tagline}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/"
          class="rounded-full border border-[rgba(50,143,151,0.3)] bg-[rgba(79,184,178,0.14)] px-5 py-2.5 text-sm font-semibold text-(--lagoon-deep) no-underline transition hover:-translate-y-0.5 hover:bg-[rgba(79,184,178,0.24)]"
        >
          View Resume →
        </a>
        <a
          href="mailto:alex@avlindfors.com"
          class="rounded-full border border-(--line) px-5 py-2.5 text-sm font-semibold text-(--sea-ink) no-underline transition hover:-translate-y-0.5 hover:bg-(--chip-bg)"
        >
          Get in Touch
        </a>
      </div>
    </section>

    <!-- What I do -->
    <section class="flex flex-col">
      <p
        class="mb-4 flex items-center gap-2 text-sm text-pink-600 dark:text-pink-200 uppercase font-bold tracking-wider"
      >
        What I do <span
          class="inline-block animate-subtle-bounce text-lg -translate-y-1.25"
          >↓</span
        >
      </p>
      <div class="mb-8 border-t border-(--line)"></div>

      <div class="flex flex-col gap-4 sm:gap-5">
        <FeatureSection
          kicker="React & TypeScript"
          headline="Interfaces that hold up under pressure."
          body="Most of my frontend work lives in React and TypeScript. I care about component boundaries, consistent state management, and UIs that behave the same way on the tenth click as on the first. I've built everything from customer-facing storefronts to internal tooling used at scale across multiple industries."
          align="left"
        />

        <FeatureSection
          kicker="Node.js & Laravel"
          headline="APIs and backends worth maintaining."
          body="On the backend I work primarily in Node.js and Laravel. I've built payment APIs, order intake systems, and third-party integrations across retail, telecom, and food-tech. Clean contracts, predictable behaviour, easy to reason about six months later."
          align="right"
        />

        <FeatureSection
          kicker="Delivery & Collaboration"
          headline="From brief to deployed, end to end."
          body="I've worked in agile product teams embedded alongside designers, product managers, and QA — joining existing codebases and greenfield projects alike. I get up to speed quickly, communicate clearly across disciplines, and care about shipping work that holds up long-term."
          align="left"
        />
        <!-- Background -->
        <FeatureSection
          kicker="Background"
          headline="To Infinity and Beyond."
          body="I started my career building distributed systems after graduating, then spent a year in Tokyo learning Japanese and working on a restaurant reservation platform. Back in Stockholm, I've worked across retail, telecom, and food-tech — on products used at scale. I'm always open to exciting opportunities, including roles abroad."
          align="center"
          linkLabel="View Resume →"
          linkHref="/"
        />
      </div>
    </section>
  </div>
</Layout>
