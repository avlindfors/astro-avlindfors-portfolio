---
---

<section class="about-cta relative overflow-hidden rounded-2xl px-8 py-8 sm:px-14 sm:py-10 print:hidden transition-shadow duration-300">
  <div class="about-cta-blob about-cta-blob--left" />
  <div class="about-cta-blob about-cta-blob--right" />

  <div class="relative flex flex-col items-center text-center gap-2.5">
    <h2 class="display-title text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight max-w-lg mb-1">
      Learn more about<br />Alexander Lindfors
    </h2>
    <p class="text-lg italic text-white/60 max-w-sm leading-relaxed">
      Stay a while and listen.
    </p>
    <a href="/about" class="cta-btn mt-2 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold no-underline transition">
      About me <span class="cta-arrow">→</span>
    </a>
  </div>
</section>

<style>
  .about-cta {
    background: linear-gradient(145deg, #173a40 0%, #0d2228 100%);
    border: 1px solid rgba(79, 184, 178, 0.15);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 24px 48px rgba(23, 58, 64, 0.18);
    transition: box-shadow 0.3s ease;
  }

  .about-cta:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 32px 64px rgba(23, 58, 64, 0.32),
      0 0 0 1px rgba(79, 184, 178, 0.18);
  }

  :global(.dark) .about-cta:hover,
  :global([data-theme='dark']) .about-cta:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 32px 64px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(79, 184, 178, 0.28);
  }

  :global(.dark) .about-cta,
  :global([data-theme='dark']) .about-cta {
    background: linear-gradient(145deg, #1e4a52 0%, #132d35 100%);
    border-color: rgba(79, 184, 178, 0.22);
  }

  .about-cta-blob {
    position: absolute;
    width: 360px;
    height: 360px;
    border-radius: 9999px;
    filter: blur(90px);
    pointer-events: none;
    opacity: 0.22;
  }

  .about-cta-blob--left {
    background: var(--lagoon);
    bottom: -80px;
    left: -80px;
  }

  .cta-btn {
    border: 1px solid rgba(251, 146, 60, 0.45);
    background: rgba(234, 88, 12, 0.22);
    color: #fed7aa;
  }

  .cta-btn:hover {
    background: rgba(234, 88, 12, 0.34);
    border-color: rgba(251, 146, 60, 0.65);
  }

  :global(.dark) .cta-btn,
  :global([data-theme='dark']) .cta-btn {
    border-color: rgba(251, 146, 60, 0.55);
    background: rgba(234, 88, 12, 0.32);
    color: #ffedd5;
  }

  :global(.dark) .cta-btn:hover,
  :global([data-theme='dark']) .cta-btn:hover {
    background: rgba(234, 88, 12, 0.46);
    border-color: rgba(251, 146, 60, 0.75);
  }

  .cta-arrow {
    display: inline-block;
    animation: bounce-x 1.2s ease-in-out infinite;
  }

  @keyframes bounce-x {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .about-cta-blob--right {
    background: color-mix(in oklab, var(--lagoon) 60%, var(--palm));
    top: -80px;
    right: -80px;
    opacity: 0.14;
  }
</style>
