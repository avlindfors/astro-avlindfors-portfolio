---
interface Props {
  kicker: string
  headline: string
  body: string
  align?: 'left' | 'right' | 'center'
  linkLabel?: string
  linkHref?: string
}

import './FeatureSection.css'

const {
  kicker,
  headline,
  body,
  align = 'left',
  linkLabel,
  linkHref,
} = Astro.props

const alignClass = {
  left: 'sm:ml-0 sm:mr-auto sm:text-left',
  right: 'sm:ml-auto sm:mr-0 sm:text-right',
  center: 'sm:mx-auto sm:text-center',
}[align]

const hoverTransform = {
  left: 'hover:transform-[perspective(900px)_rotateX(1deg)_rotateY(2deg)]',
  right: 'hover:transform-[perspective(900px)_rotateX(1deg)_rotateY(-2deg)]',
  center: 'hover:transform-[perspective(900px)_rotateX(1deg)_rotateY(1.5deg)]',
}[align]
---

<div
  data-feature-card
  data-align={align}
  class={`group relative overflow-hidden rounded-2xl border border-transparent p-2 sm:p-6 transition-all duration-300 ease-out hover:shadow-[0_8px_32px_rgba(23,58,64,0.12)] dark:hover:shadow-[0_8px_32px_rgba(0,0,0,0.35)] dark:hover:border-(--line) ${hoverTransform}`}
>
  {
    align !== 'center' ? (
      <div class="feature-blob bg-gray-400 dark:bg-slate-500 hidden sm:block" />
    ) : (
      <>
        <div
          class={
            'feature-blob-center feature-blob-center--left bg-gray-400 dark:bg-slate-500 hidden sm:block'
          }
        />
        <div
          class={
            'feature-blob-center feature-blob-center--right bg-gray-400 dark:bg-slate-500 hidden sm:block'
          }
        />
      </>
    )
  }
  <div class={`relative mx-auto max-w-lg text-center ${alignClass}`}>
    <h2
      class="display-title text-2xl font-bold tracking-wide text-(--sea-ink) sm:text-3xl mb-0.5 transition-colors duration-300 group-hover:text-pink-800 group-hover:dark:text-pink-200"
    >
      {kicker}
    </h2>
    <p
      class="font-sans mb-3 text-base text-teal-850 leading-snug tracking-wider font-medium"
    >
      {headline}
    </p>
    <p class="text-(--sea-ink-soft) leading-relaxed text-lg">{body}</p>
    {
      linkHref && linkLabel && (
        <a
          href={linkHref}
          class="mt-6 inline-block rounded-full border border-[rgba(50,143,151,0.3)] bg-[rgba(79,184,178,0.14)] px-6 py-2.5 text-sm font-semibold text-(--lagoon-deep) no-underline transition hover:-translate-y-0.5 hover:bg-[rgba(79,184,178,0.24)]"
        >
          {linkLabel}
        </a>
      )
    }
  </div>
</div>

<script>
  const transforms: Record<string, string> = {
    left: 'perspective(700px) rotateX(3deg) rotateY(4deg)',
    right: 'perspective(700px) rotateX(3deg) rotateY(-4deg)',
    center: 'perspective(700px) rotateX(2deg) rotateY(3deg)',
  }

  const isMobile = () => window.matchMedia('(max-width: 639px)').matches

  const observer = new IntersectionObserver(
    (entries) => {
      if (!isMobile()) return
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement
        const align = el.dataset.align ?? 'left'
        if (entry.isIntersecting) {
          el.style.transform = transforms[align]
          el.classList.add('is-centered')
        } else {
          el.style.transform = ''
          el.classList.remove('is-centered')
        }
      })
    },
    { rootMargin: '-25% 0px -25% 0px', threshold: 0 },
  )

  document
    .querySelectorAll('[data-feature-card]')
    .forEach((el) => observer.observe(el))
</script>
