---
interface Props {
  kicker: string
  headline: string
  body: string
  align?: 'left' | 'right' | 'center'
  linkLabel?: string
  linkHref?: string
}

const { kicker, headline, body, align = 'left', linkLabel, linkHref } = Astro.props

const alignClass = {
  left: 'sm:ml-0 sm:mr-auto sm:text-left',
  right: 'sm:ml-auto sm:mr-0 sm:text-right',
  center: 'sm:mx-auto sm:text-center',
}[align]
---

<div>
  <div class={`mx-auto max-w-lg text-center ${alignClass}`}>
    <p class="island-kicker mb-1">{kicker}</p>
    <h3
      class="display-title mb-4 text-3xl font-bold leading-tight text-(--sea-ink) sm:text-4xl"
    >
      {headline}
    </h3>
    <p class="text-(--sea-ink-soft) leading-relaxed text-lg">{body}</p>
    {linkHref && linkLabel && (
      <a href={linkHref} class="mt-6 inline-block rounded-full border border-[rgba(50,143,151,0.3)] bg-[rgba(79,184,178,0.14)] px-6 py-2.5 text-sm font-semibold text-(--lagoon-deep) no-underline transition hover:-translate-y-0.5 hover:bg-[rgba(79,184,178,0.24)]">
        {linkLabel}
      </a>
    )}
  </div>
</div>
