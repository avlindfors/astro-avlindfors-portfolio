{
  "name": "avlindfors-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "docker:build": "docker build -t avlindfors-portfolio .",
    "docker:up": "npm run docker:build && docker stop avlindfors-portfolio 2>/dev/null; docker rm avlindfors-portfolio 2>/dev/null; docker run -d --name avlindfors-portfolio --restart unless-stopped -p 3000:80 avlindfors-portfolio",
    "docker:down": "docker stop avlindfors-portfolio && docker rm avlindfors-portfolio",
    "docker:logs": "docker logs -f avlindfors-portfolio"
  },
  "overrides": {
    "devalue": "5.8.1",
    "postcss": "8.5.15"
  },
  "dependencies": {
    "@astrojs/react": "5.0.5",
    "@astrojs/sitemap": "3.7.2",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.3.7",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  }
}
